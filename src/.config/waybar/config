{
    "layer": "top", // Waybar at top layer
    // Choose the order of the modules
    "modules-left": [
        "ext/workspaces",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/tailscale",
        "network",
        "pulseaudio",
        "pulseaudio#mic",
        "custom/performance",
	"battery",
	"tray",
        "clock#calendar",
        "clock"
    ],
    // Modules
    // ext/workspaces, not hyprland/workspaces: under a Lua Hyprland config the
    // socket1 `dispatch` payload is evaluated as Lua, so the legacy string form
    // waybar sends ("dispatch workspace 2") is a Lua syntax error and clicking a
    // workspace silently does nothing. ext/workspaces activates over the
    // ext-workspace-v1 Wayland protocol instead, so it never touches hyprctl.
    "ext/workspaces": {
        "on-click": "activate",
        "all-outputs": true,
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "󰣇",
            "2": "󰅴",
            "3": "󱂛",
            "4": "󰘦",
            "5": "󰆼",
            "9": "󰍪",
            "10": "󰫔",
            "urgent": "󰗖",
            "active": "󰐾",
            "default": "󰐽"
        }
    },
    "hyprland/window": {
        "max-length": 60
    },
    // The calendar tooltip is what the empty tooltip was trying to be: the
    // clock module only renders {calendar} if a calendar block exists. locale is
    // set explicitly because {calendar} ignores the system locale when picking
    // the start-of-week, per waybar-clock(5).
    "clock#calendar": {
        "locale": "en_US.UTF-8",
        "format": "󰸗 {:%D}",
        "format-alt": "󰸗 {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        // Without a threshold every fractional touchpad scroll delta counts as a
        // shift, so one flick jumps a dozen months. This accumulates them instead.
        "smooth-scrolling-threshold": 4.0,
        "calendar": {
            "mode": "month",
            // Only used by the year view (right-click), but it has to be set here:
            // left unset, toggling to year at runtime renders a single column.
            "mode-mon-col": 3,
            "on-scroll": 1,
            // Structural markup only, no colors: the tooltip inherits the pywal
            // palette from style.css, so hardcoded hex here would fight the theme.
            "format": {
                "months": "<b>{}</b>",
                "weekdays": "<b>{}</b>",
                "today": "<b><u>{}</u></b>"
            }
        },
        // on-click is left alone so format-alt still toggles the long date.
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    // 12-hour time lives in the tooltip rather than a format-alt: hovering beats
    // click-toggling for something you only want to read occasionally.
    "clock": {
        "format": "󰅐 {:%H:%M}",
        "tooltip-format": "{:%I:%M %p}"
    },
    // Power profile + CPU/RAM in one icon (custom-modules/performance.py).
    // The icon is the active tlp-pd profile and turns red when CPU or RAM is
    // at 80%+; the tooltip has the profile, per-core CPU and RAM used.
    // Left-click cycles power-saver -> balanced -> performance (TLP_AUTO_SWITCH=2
    // keeps the pick until the charger is plugged/unplugged); right-click htop.
    "custom/performance": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/custom-modules/performance.py 2> /dev/null",
        // Signals every running copy (one per monitor); they update their icons
        // immediately and the primary copy switches the profile in-process (no
        // Python start-up per click). Pattern must match PROCESS_PATTERN.
        "on-click": "pkill -USR1 -f '^python3 [^ ]*/custom-modules/performance\\.py$'",
        "on-click-right": "alacritty -e htop"
    },
    "battery": {
        "bat": "BAT0",
        // Keep in sync with BATTERY_WARNING / BATTERY_CRITICAL in
        // custom-modules/performance.py (low-battery notifications).
        "states": {
            "warning": 15,
            "critical": 5
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon}󱐌",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "network": {
        "format-wifi": "{essid} {icon}",
        "tooltip-format-wifi": "{essid}: {ipaddr}/{cidr} ({signalStrength}%) {icon}",
        "format-ethernet": "{ipaddr}/{cidr} 󰈁",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr} 󰈁",
        "format-disconnected": "Disconnected 󰤮",
        // Replaces nm-applet's tray dropdown: NetworkManager's terminal UI for
        // picking Wi-Fi networks and editing connections.
        "on-click": "alacritty -e nmtui",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ]
    },
    "pulseaudio": {
        // Icon only; the percentage lives in the hover tooltip.
        "format": "{icon}",
        "format-bluetooth": "{icon}󰂰",
        "tooltip-format": "Volume: {volume}%\n{desc}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphones": "󰋋",
            "handsfree": "󰋎",
            "headset": "󰋎",
            "phone": "󰄜",
            "portable": "󰓶",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "alacritty -e pulsemixer"
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
	"format-source": "󰍬",
	"format-source-muted": "󰍭",
	"tooltip-format": "Mic: {format_source}",
        "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
    },
    "bluetooth": {
        "format": "{status} 󰂯",
        "format-connected": "{device_alias} 󰂱",
        "format-connected-battery": "{device_alias} {device_battery_percentage}% 󰥉",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
    },
    "tray": {
    	"icon-size": 16,
	"spacing": 10
    },
    "custom/media": {
        "format": "{}",
        "max-length": 40,
        "exec": "$HOME/.config/waybar/custom-modules/media.py 2> /dev/null",
        "exec-if": "command -v playerctl",
        // Control the player the module is showing (media.py records it),
        // not whichever player playerctl would pick by itself.
        // If nothing is showing there is no file and the click does nothing.
        "on-click": "p=$(cat $XDG_RUNTIME_DIR/waybar-media-player 2>/dev/null) && playerctl -p \"$p\" play-pause",
        "on-click-right": "p=$(cat $XDG_RUNTIME_DIR/waybar-media-player 2>/dev/null) && playerctl -p \"$p\" next"
    },
    "custom/tailscale": {
        "format": "{}",
        "return-type": "json",
        "interval": 10,
        "signal": 8,
        "exec": "$HOME/.config/waybar/custom-modules/tailscale.py 2> /dev/null",
        "exec-if": "command -v tailscale",
        "on-click": "$HOME/.config/waybar/custom-modules/tailscale.py toggle",
        "on-click-middle": "tailscale ip -4 | tr -d '\\n' | wl-copy",
        "menu": "on-click-right",
        "menu-file": "/home/brian/.config/waybar/custom-modules/tailscale-menu.xml",
        "menu-actions": {
            "connect": "/home/brian/.config/waybar/custom-modules/tailscale.py up",
            "disconnect": "/home/brian/.config/waybar/custom-modules/tailscale.py down",
            "dns-on": "/home/brian/.config/waybar/custom-modules/tailscale.py dns on",
            "dns-off": "/home/brian/.config/waybar/custom-modules/tailscale.py dns off",
            "copy-ip": "tailscale ip -4 | tr -d '\\n' | wl-copy",
            "admin": "xdg-open https://login.tailscale.com/admin/machines",
            "status": "alacritty -e tailscale status"
        }
    }
}
